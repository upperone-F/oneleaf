# ============================================================
# Oneleaf · 跨平台换行符规则（核心：统一用 LF，杜绝整文件变红）
# Mac 与 Windows 来回 clone/pull 时，Git 按此规则自动转换
# ============================================================

# 默认：所有文本文件在仓库内统一存为 LF
* text=auto eol=lf

# 明确声明为文本的文件（强制 LF）
*.dart      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.sh        text eol=lf
*.gradle    text eol=lf
*.properties text eol=lf
*.xml       text eol=lf
*.kt        text eol=lf
*.swift     text eol=lf
*.java      text eol=lf

# gradlew 脚本必须是 LF，否则 Windows/Mac 执行报 \r 错误
gradlew     text eol=lf

# 二进制文件：禁止任何转换（否则图片/字体/签名损坏）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.p12   binary
*.jks   binary
*.keystore binary
*.aar   binary
*.jar   binary
